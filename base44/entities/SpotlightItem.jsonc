{
  "name": "SpotlightItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the submission"
    },
    "author_name": {
      "type": "string",
      "description": "Creator name"
    },
    "author_age": {
      "type": "number",
      "description": "Creator age (if child)"
    },
    "author_city": {
      "type": "string",
      "description": "Creator city"
    },
    "image_url": {
      "type": "string",
      "description": "Image of the submission"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Show in spotlight section"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "title",
    "author_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.status": "pending"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}