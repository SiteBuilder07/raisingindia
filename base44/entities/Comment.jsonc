{
  "name": "Comment",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the article"
    },
    "author_name": {
      "type": "string",
      "description": "Commenter name"
    },
    "author_email": {
      "type": "string",
      "description": "Commenter email (private, admin only)"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether comment is approved"
    }
  },
  "required": [
    "article_id",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}