{
  "name": "Comment",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the article"
    },
    "author_name": {
      "type": "string",
      "description": "Commenter display name"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether comment is approved (admin moderation)"
    }
  },
  "required": [
    "article_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_approved": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_approved": {
            "$ne": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}