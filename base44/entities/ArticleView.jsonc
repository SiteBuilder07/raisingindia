{
  "name": "ArticleView",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the viewed article"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Server-written dedupe key (view:<ip>:<article>:<date>)"
    }
  },
  "required": [
    "article_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}