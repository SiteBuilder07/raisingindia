{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "ID of the bookmarked article"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who bookmarked"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description for this bookmark"
    }
  },
  "required": [
    "article_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}